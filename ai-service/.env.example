# Which analysis engine to use: vader | huggingface | llm  (default: vader)
#   - vader        : VADER sentiment + keyword-rule categories (no extra deps)
#   - huggingface  : pretrained HF sentiment + zero-shot categories
#   - llm          : LLM API returning strict JSON, VADER fallback on failure
SENTIMENT_ENGINE=vader

# --- Hugging Face engine (SENTIMENT_ENGINE=huggingface) ---
# Defaults shown; any sentiment / zero-shot model on the Hub can be used.
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
HF_ZERO_SHOT_MODEL=typeform/distilbert-base-uncased-mnli

# --- LLM engine (SENTIMENT_ENGINE=llm) ---
# Any OpenAI-compatible /chat/completions endpoint works.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10