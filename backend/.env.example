PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_analytics
JWT_SECRET=supersecret_jwt_key_change_me
AI_SERVICE_URL=http://localhost:8000

# --- AI client (backend -> ai-service) ---
# Retries with exponential backoff for transient failures (network/timeout/5xx).
AI_MAX_ATTEMPTS=3
AI_TIMEOUT_MS=5000

# --- Background analysis worker ---
# How often the worker polls the analysis_queue (ms) and how many jobs it claims
# per batch. Jobs retry up to their own max_attempts before being marked failed.
ANALYSIS_POLL_INTERVAL_MS=2000
ANALYSIS_BATCH_SIZE=5
